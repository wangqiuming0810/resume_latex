{
    // 这里保留你原有其他配置……
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipe.default": "xelatex‑3次(简历tikz头像)",
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex‑3次(简历tikz头像)",
            "tools": [
                "xelatex",
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab"
}
